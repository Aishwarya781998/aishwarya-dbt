With sales as

(
    Select

 sales_id,
 product_sk,
 customer_sk,
 {{multiply('unity_price', 'quantity')}} as calculated_gross_amount
 gross_amount,
 payment_method
  
  from {{ref('bronze_sales')}}
),

products as (
    select 
    product_sk,
    category

from {{ ref('bronze_product') }}
),

customer as
(
    select customer_sk,
    gender
    from {{ref('bronze_customer')}}
    )

validated_query as (
select 
sales.sales_id,
sales.gross_amount,
sales.payment_method,
product.category,
cutomer.gender

from sales
 join product on sales.product_sk = product.product_sk
 join customer on sales.customer_sk = customer.customer_sk

)

select 

category,
 gender,
  sum(gross_amount) as total_sales

from 

validated_query

group by category, gender
order by total_sales desc

